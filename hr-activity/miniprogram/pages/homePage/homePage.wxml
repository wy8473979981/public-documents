<!--pages/homePage/homePage.wxml-->
<view class="home-wrapper">
  <view class="header-wrapper">
    <view class="text-1">弹福星旅探索</view>
    <view class="text-2">赢取福气好礼</view>
  </view>
  <view class="rule-flow"></view>
  <view class="flow-wrapper">
    <view wx:for="{{ gameList }}" wx:for-item="game" wx:key="index" class="game game-{{index}}" data-game="{{game}}" bindtap="onClickGame">
      <view class="game-num game-num-{{index}}">{{game.gameNum}}</view>
      <view class="title title-{{index}}">{{game.gameTitle}}</view>
      <view class="explain explain-{{index}}">{{game.gameEXplain}}</view>
      <image class="gif-{{index}}" src="{{game.gameGif}}" mode="aspectFit"></image>
    </view>
  </view>
</view>